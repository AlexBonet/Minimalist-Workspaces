---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const workspaces = await getCollection("workspaces");
  const paths: any[] = [];
  ["es", "en"].forEach((lang) => {
    workspaces.forEach((ws) => {
      paths.push({
        params: { lang, slug: ws.id },
        props: { workspace: ws, lang },
      });
    });
  });
  return paths;
}

const { workspace, lang } = Astro.props;
const { title, description, coverImage, tags, specs, publishDate } =
  workspace.data;
const l = lang as "es" | "en";
---

<Layout
  title={`${title[l]} - Minimalist Workspaces`}
  lang={l}
  showHeader={false}
  showFooter={false}
  mainClass="min-h-screen p-0"
>
  <div class="min-h-screen w-full lg:grid lg:grid-cols-2">
    <!-- Image Section -->
    <div class="h-[40vh] lg:h-screen lg:sticky lg:top-0">
      <Image
        src={coverImage}
        alt={title[l]}
        class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700"
      />
    </div>

    <!-- Content Section -->
    <div
      class="bg-white px-8 py-12 lg:px-16 lg:py-24 flex flex-col justify-center"
    >
      <!-- Back Link (top) -->
      <a
        href={`/${lang}/`}
        class="inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-widest mb-12 hover:opacity-60 transition-opacity"
      >
        <span class="text-lg leading-none">&larr;</span>
        {lang === "es" ? "Volver al archivo" : "Back to archive"}
      </a>

      <!-- Title -->
      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-black tracking-tighter leading-[0.9] mb-6"
      >
        {title[l]}
      </h1>

      <!-- Description -->
      <p
        class="text-base lg:text-lg leading-relaxed text-gray-700 mb-10 max-w-md"
      >
        {description[l]}
      </p>

      <!-- Tags -->
      {
        tags && tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-10">
            {tags.map((tag: string) => (
              <span class="text-[10px] font-bold uppercase tracking-widest px-3 py-1.5 border border-black">
                {tag}
              </span>
            ))}
          </div>
        )
      }

      <!-- Specs -->
      {
        specs && (
          <div class="border-t-2 border-black pt-8">
            <h2 class="text-[10px] font-bold uppercase tracking-widest mb-6">
              {lang === "es" ? "Especificaciones" : "Specifications"}
            </h2>
            <dl class="grid grid-cols-1 gap-4">
              {specs.computer && (
                <div class="flex justify-between items-baseline border-b border-gray-200 pb-3">
                  <dt class="text-[10px] uppercase tracking-widest text-gray-500">
                    Computer
                  </dt>
                  <dd class="text-sm font-bold">{specs.computer}</dd>
                </div>
              )}
              {specs.monitor && (
                <div class="flex justify-between items-baseline border-b border-gray-200 pb-3">
                  <dt class="text-[10px] uppercase tracking-widest text-gray-500">
                    Monitor
                  </dt>
                  <dd class="text-sm font-bold">{specs.monitor}</dd>
                </div>
              )}
              {specs.keyboard && (
                <div class="flex justify-between items-baseline border-b border-gray-200 pb-3">
                  <dt class="text-[10px] uppercase tracking-widest text-gray-500">
                    Keyboard
                  </dt>
                  <dd class="text-sm font-bold">{specs.keyboard}</dd>
                </div>
              )}
              {specs.mouse && (
                <div class="flex justify-between items-baseline border-b border-gray-200 pb-3">
                  <dt class="text-[10px] uppercase tracking-widest text-gray-500">
                    Mouse
                  </dt>
                  <dd class="text-sm font-bold">{specs.mouse}</dd>
                </div>
              )}
            </dl>
          </div>
        )
      }

      <!-- Publish Date -->
      {
        publishDate && (
          <p class="mt-10 text-[10px] uppercase tracking-widest text-gray-500">
            {lang === "es" ? "Publicado" : "Published"}:{" "}
            {new Date(publishDate).toLocaleDateString(
              lang === "es" ? "es-ES" : "en-US",
              { year: "numeric", month: "long", day: "numeric" },
            )}
          </p>
        )
      }
    </div>
  </div>
</Layout>
