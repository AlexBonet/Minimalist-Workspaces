---
import { ui } from "../i18n/ui";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;

const t = ui[lang];
---

<footer class="w-full bg-white text-black border-t-2 border-black">
  <div class="grid grid-cols-1 lg:grid-cols-12">
    <!-- Column 1: Identity -->
    <div
      class="lg:col-span-4 p-6 md:p-12 flex flex-col justify-between border-b-2 lg:border-b-0 lg:border-r-2 border-black min-h-[300px] lg:min-h-[400px]"
    >
      <div>
        <h2
          class="text-4xl md:text-5xl font-bold tracking-tighter leading-[0.9] mb-4"
        >
          {t["footer.identity.title"]}
        </h2>
      </div>
      <p class="text-sm font-medium tracking-tight">
        {t["footer.identity.subtext"]}
      </p>
    </div>

    <!-- Column 2: Context -->
    <div
      class="lg:col-span-4 p-6 md:p-12 flex flex-col justify-between border-b-2 lg:border-b-0 lg:border-r-2 border-black min-h-[300px] lg:min-h-[400px]"
    >
      <div>
        <span
          class="text-xs font-bold uppercase tracking-widest underline decoration-1 underline-offset-4 mb-4 block"
        >
          {t["footer.context.label"]}
        </span>
        <p class="text-xl md:text-2xl font-medium leading-snug tracking-tight">
          {t["footer.context.text"]}
        </p>
      </div>
    </div>

    <!-- Column 3: Connections -->
    <div
      class="lg:col-span-4 p-6 md:p-12 flex flex-col justify-between min-h-[300px] lg:min-h-[400px]"
    >
      <div class="w-full flex flex-col items-start lg:items-end">
        <span
          class="text-xs font-bold uppercase tracking-widest underline decoration-1 underline-offset-4 mb-4 block"
        >
          {t["footer.connect.label"]}
        </span>
        <nav class="flex flex-col gap-2 items-start lg:items-end w-full">
          {
            [
              { text: t["footer.connect.github"], url: "https://github.com" },
              {
                text: t["footer.connect.linkedin"],
                url: "https://linkedin.com",
              },
            ].map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-4xl md:text-5xl font-bold tracking-tighter hover:bg-black hover:text-white transition-colors duration-300 block py-2 px-1 -mr-1"
              >
                {link.text}
              </a>
            ))
          }
        </nav>
      </div>
    </div>
  </div>
</footer>
